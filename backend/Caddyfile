# Caddy sebagai reverse proxy + penerbit TLS otomatis.
#
# Kenapa Caddy, bukan nginx + certbot: Caddy otomatis menemukan kebutuhan
# sertifikat, memperbaruinya, dan memuatkannya tanpa interaksi. Nginx +
# certbot perlu cron yang harus tetap jalan; kalau cron itu mati, sertifikat
# kadaluarsa dalam 90 hari dan situs mati tanpa ada yang salah. Untuk deployment
# yang berjalan tanpa disentuh seperti ini, satu proses yang mengurus
# sendiri adalah pilihan yang tepat.
#
# Ganti domain di bawah dengan domain Anda. Domain placeholder membuat
# penerbitan TLS selalu gagal: `example.com` milik IANA, tidak akan pernah
# mendapat sertifikat, dan Caddy keluar dengan error ACME.
#
# Sebelum `docker compose up`:
#   docker compose run --rm caddy sed -i 's/example\.com/domain-anda/g' /etc/caddy/Caddyfile
#
# Uji coba lokal tanpa TLS: `caddy run --config Caddyfile --adapter caddyfile`
# dengan baris `localhost` di bawah diganti `http://localhost`.

{
	# Email ini hanya dipakai untuk pemberitahuan kedaluwarsa sertifikat.
	# Kosongkan kalau tidak ingin memberi tahu siapa pun.
	email admin@example.com

	# OCSP stapling dibiarkan pada setelan bawaan Caddy (aktif).
	#
	# Opsi global `ocsp_stapling` hanya menerima `off`. Nilai seperti `on`
	# ditolak parser saat Caddy mengadopsi konfigurasi ini, dan karena
	# adaptasi happens sebelum server listen, container langsung keluar dengan
	# crash-loop -- satu baris salah mematikan seluruh ingress.
	#
	# Verifikasi sebelum deploy: `docker compose run --rm caddy caddy validate
	# --config /etc/caddy/Caddyfile`
}

# Frontend dan API dilayani dari satu domain agar cookie sesi bekerja tanpa
# CORS. Frontend (Next.js) diasumsikan sudah berjalan -- lihat README bagian
# "Menjalankan frontend".
example.com {
	encode zstd gzip

	# Header keamanan dasar. `Content-Security-Policy` sengaja tidak
	# disetel ketat di sini karena frontend Next.js memakai inline script
	# untuk hydration; tighten nanti kalau sudah ada kebijakan konkret.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# API. Prefix `/api/v1` diteruskan apa adanya; upstream tidak boleh
	# ditulis ulang ke `/`, karena FastAPI sudah tahu path lengkapnya dan
	# menulis ulang ke / akan memecahkan path OpenAPI.
	handle /api/v1/* {
		reverse_proxy api:8000 {
			# SSE (streaming jawaban) butuh buffering dimatikan. Tanpa ini,
			# respons terkirim utuh di akhir dan pengguna melihat jawaban
			# tiba-tiba sekaligus -- bukan streaming sama sekali.
			flush_interval -1

			# Batas timeout lebih longgar dari default 60 detik supaya
			# generasi LLM yang lambat tidak diputus di tengah.
			transport http {
				read_timeout 300s
			}
		}
	}

	# Sisanya ditangani frontend Next.js.
	handle {
		reverse_proxy frontend:3000
	}
}
