# Konfigurasi backend. Salin jadi .env lalu isi seperlunya.
# .env tidak boleh di-commit.

# ------------------------------------------------------------------ app
# Biarkan false di server yang bisa diakses publik. `true` hanya untuk
# pengembangan lokal: pesan error internal ikut terkirim ke klien.
DEBUG=false

# Origin frontend yang diizinkan, dipisah koma. JANGAN isi `*`.
# Aplikasi ini memakai cookie sesi, dan CORS dengan `*` membuat situs mana pun
# bisa membaca respons API memakai sesi pengguna yang sedang login. Nilainya
# ditolak saat start, bukan hanya diperingatkan.
# Contoh produksi: CORS_ORIGINS=https://domain-anda.example
CORS_ORIGINS=http://localhost:3000

# Tampilkan dokumentasi API interaktif di /docs dan /redoc. Default mati.
# Skema OpenAPI memuat seluruh bentuk request dan response termasuk nama field
# internal, dan /docs membiarkan siapa pun mencoba endpoint tanpa menulis kode.
# Nyalakan (1) hanya kalau aplikasi ini memang demo portofolio publik.
API_DOCS_ENABLED=0

# Percayai `X-Forwarded-For` untuk key rate limit. Nyalakan hanya kalau API
# selalu dijangkau lewat reverse proxy tepercaya (compose+Caddy sudah menyalakan
# ini lewat environment). Tanpa proxy, klien bisa menyusun ulang bucket rate
# limit sesuka hatinya lewat header palsu.
TRUST_PROXY_HEADERS=0

# ---------------------------------------------------------------- security
# WAJIB diisi. Ini SHA-256 dari passcode, bukan passcode-nya.
# Buat dengan:  python -m scripts.make_passcode
# Skrip itu menolak passcode di bawah 12 karakter, karena passcode ini
# melindungi seluruh dokumen pengguna.
ACCESS_PASSCODE_SHA256=
SESSION_TTL_SECONDS=86400
AUTH_MAX_ATTEMPTS=5
AUTH_WINDOW_SECONDS=300
# Mode demo publik: backend menerbitkan sesi otomatis untuk setiap pengunjung
# dan passcode dilewati (frontend juga butuh NEXT_PUBLIC_OPEN_MODE=1).
# Matikan untuk mengembalikan gate passcode seperti semula.
AUTH_OPEN_MODE=0

# --------------------------------------------------------------------- llm
# groq              : API cloud, free tier, paling cepat untuk mulai
# openai_compatible : endpoint OpenAI-compatible milik sendiri (router/proxy)
# ollama            : model lokal, data tidak keluar dari mesin
# sglang            : self-hosted, untuk trafik RAG dengan prefix bersama
LLM_PROVIDER=mock
# Rantai fallback, dipisah koma. Contoh: groq,ollama
# Kalau Groq kena 429, otomatis pindah ke Ollama.
LLM_FALLBACK_CHAIN=
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=30

# Kosongkan kalau belum mau memakai Groq. Free tier: 1000 request/hari.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Nama model Groq, menimpa LLM_MODEL bila diisi. Perlu untuk rantai fallback
# lintas provider: katalog model provider primary (mis. endpoint
# OpenAI-compatible) beda dari Groq, jadi fallback butuh nama model yang
# benar-benar ada di Groq.
GROQ_MODEL=

# --------------------------------------------------- openai-compatible
# Endpoint OpenAI-compatible milik sendiri (router/agregator/proxy).
# Berguna sebagai provider utama atau fallback saat kuota provider lain habis.
# Isi BASE_URL dengan alamat endpoint Anda; API key mengikuti penyedia.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://endpoint-anda.example/v1

# Model lokal. qwen2.5:3b jalan di CPU, qwen2.5:7b butuh GPU lebih baik.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# Self-hosted untuk beban lebih besar.
SGLANG_BASE_URL=http://localhost:30000/v1
SGLANG_MODEL=qwen2.5-3b-instruct

# ------------------------------------------------------- vision / OCR (PDF scan)
# Cara PDF diproses:
#   auto   = text-layer dinilai; yang utuh dipakai, yang rusak/kosong di-OCR
#   vision = semua PDF selalu di-OCR lewat model vision
#   text   = OCR dimatikan sepenuhnya (perilaku lama)
INGEST_PDF_MODE=auto
# Provider dan model multimodal untuk OCR. Butuh API key sesuai provider:
# groq -> GROQ_API_KEY, ollama/sglang -> server lokal. Free tier Groq dengan
# meta-llama/llama-4-scout cukup untuk dokumen legal hasil pindai. CEK DAFTAR
# MODEL AKUN ANDA (GET /openai/v1/models): kalau model vision tidak ada,
# pakai OCR_ENGINE=paddle - OCR sepenuhnya lokal tanpa API.
VISION_PROVIDER=groq
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
VISION_TEMPERATURE=0
VISION_MAX_TOKENS=2048
VISION_TIMEOUT_SECONDS=90
# Skala render halaman ke gambar (2.0 = 144 DPI untuk halaman 72 DPI).
PDF_RENDER_SCALE=2.0
# Jeda antar halaman saat OCR (gratis-tier provider membatasi token/menit).
OCR_REQUEST_DELAY_SECONDS=1.0
OCR_MAX_RETRIES=2
# Mesin OCR untuk halaman yang perlu diekstraksi:
#   auto   = PP-OCR lokal (RapidOCR) utama; halaman confidence rendah
#            dieskalasi ke model vision. Butuh `pip install -e .[ocr]`.
#   paddle = PP-OCR lokal saja, tanpa biaya API.
#   vision = model vision untuk semua halaman (perilaku lama).
OCR_ENGINE=auto
# Confidence rata-rata halaman di bawah ini -> halaman dikirim ke model vision.
OCR_VLM_RESCUE_CONFIDENCE=0.55
# Pass kedua: celah antar baris di-crop + OCR ulang zoom 2x (baris tertutup cap).
OCR_GAP_RESCAN_ENABLED=1

# ------------------------------------------------- prompt injection guard
# Classifier meta-llama/llama-prompt-guard-2-86m menilai SETIAP konten yang
# akan masuk prompt LLM; skor risiko di atas ambang diblokir keluar dari
# konteks dan tidak disitasi. Memakai provider LLM yang sama (GROQ_API_KEY).
# Fail-open: classifier gagal -> konten lolos tanpa nilai, jawaban tetap jalan.
PROMPT_GUARD_ENABLED=1
PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
PROMPT_GUARD_THRESHOLD=0.5

# ---------------------------------------------------------------- embedding
# Multilingual, karena dokumen dan pertanyaan berbahasa Indonesia.
# Model Inggris-first seperti all-MiniLM-L6-v2 jauh lebih buruk untuk Bahasa
# Indonesia, dan pengaruhnya ke recall_at_5 turun tajam.
# e5-base: recall Bahasa Indonesia lebih baik daripada -small, latensi query
# tetap di bawah 100 ms CPU. Mengganti model = dimensi berubah: indeks Chroma
# lama menandai signature mismatch dan perlu `python -m scripts.reindex`.
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768
# Set 0 untuk memakai stub hashing di test.
USE_LOCAL_EMBEDDING=1

# ----------------------------------------------------------------- chunking
# Chunking legal: dokumen yang terdeteksi sebagai peraturan (heading
# BAB/Bagian/Pasal) dipecah per Pasal dengan header konteks, bukan per
# paragraf. Set 0 untuk mematikan dan selalu memakai chunking paragraf.
LEGAL_CHUNKING_ENABLED=1
LEGAL_CHUNK_MAX_CHARS=900

# --------------------------------------------------------------- retrieval
# Rentang di sini harus sama persis dengan slider di frontend. Kalau tidak,
# nilai aktif tidak bisa diwakili slider dan pengguna menggeser control yang
# tidak memberi efek.
DEFAULT_TOP_K=5
MIN_TOP_K=3
MAX_TOP_K=10
# 0.5 dipilih karena ambang ini diterapkan pada bukti mentah: cosine
# similarity vektor atau skor BM25 yang sudah diskalakan. Pada embedding
# sungguhan, cosine untuk pertanyaan yang relevan biasanya di atas 0.6, jadi
# 0.5 menyisakan ruang untuk chunk benar yang similarity-nya moderate tanpa
# membiarkan apa pun lolos.
DEFAULT_SIMILARITY_THRESHOLD=0.82
MIN_SIMILARITY_THRESHOLD=0.75
MAX_SIMILARITY_THRESHOLD=0.92
HISTORY_MESSAGE_COUNT=6
CACHE_TTL_SECONDS=1800
QUERY_MAX_PER_SESSION=20
QUERY_WINDOW_SECONDS=60

# Retensi log query, dalam hari. 0 berarti simpan selamanya.
# Tanpa retensi, tabel query_logs tumbuh terus dan dashboard mulai memotong
# data lama secara diam-diam: angka latency dan token hanya mencerminkan
# sebagian riwayat tanpa tanda apa pun.
QUERY_LOG_RETENTION_DAYS=90

# Reranking dua tahap dengan cross-encoder.
#
# Ambang tunggal tidak bisa memisahkan sempurna: skor chunk benar 0.804-0.875
# dan chunk salah 0.748-0.879, tumpang tindih. Reranking menilai ulang
# kandidat dengan cross-encoder dan menaikkan ketepatan posisi pertama dari
# 4/11 menjadi 7/11 pada dataset contoh.
#
# Mati secara default karena menambah ~80 MB model dan waktu respons.
# Reranker multilingual (100+ bahasa termasuk Indonesia, Apache-2.0). Biaya:
# ~1.1 GB RAM dan +150-400ms per query di CPU; gagal dimuat = retrieval
# berjalan tanpa reranking (peringatan di log), aplikasi tetap hidup.
RERANK_ENABLED=1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu
RERANK_CANDIDATES=8

# Tier bukti lemah: kalau ambang menolak semua tapi masih ada kandidat dengan
# skor vektor >= floor, pertanyaan dijawab dengan label "bukti terbatas"
# alih-alih ditolak keras.
WEAK_EVIDENCE_FLOOR=0.60
# Tetangga chunk (chunk_index +/- N) ikut ke prompt sebagai konteks sekitar,
# dilarang disitasi. 0 = matikan.
CONTEXT_WINDOW_CHUNKS=1
# Batas karakter total blok konteks di prompt.
MAX_CONTEXT_CHARS=8000

# Stemming Sastrawi pada token BM25 (pengaduan/mengadu/diadukan -> adu).
# Wajib sama untuk dokumen dan query, dan memang seragam dari satu tempat.
BM25_STEMMING_ENABLED=1

# --------------------------------------------------------------- documents
MAX_FILE_SIZE_BYTES=10485760
# Batas jumlah dokumen. Batas per berkas 10 MB tidak membatasi apa pun kalau
# jumlah berkasnya tidak dibatasi.
MAX_DOCUMENTS=200
# Batas total ukuran seluruh dokumen, dalam byte (1 GB). Tanpa ini, 200 berkas
# berukuran 10 MB berarti 2 GB.
MAX_TOTAL_DOCUMENT_BYTES=1073741824

# ------------------------------------------------------------------ redis
# Kosongkan untuk memakai store in-process. Itu pilihan yang benar untuk satu
# instance: Redis menyelesaikan masalah "banyak instance berbagi state", dan
# instance-nya cuma satu.
#
# Konsekuensi yang perlu diketahui: MERESTART LALU DATA SESI HILANG -- judul
# dan jumlah pesan tetap ada di SQLite, tapi isi percakapannya tidak. Untuk
# portofolio ini tidak masalah. Kalau nanti butuh histori bertahan, simpan isi
# pesan ke SQLite (tabelnya sudah ada) daripada menambah Redis.
REDIS_URL=
# Upstash juga dibaca: isi keduanya (atau salah satu) dan store memakai TLS ke
# host Upstash. URL dan token di bagian ini adalah kredensial.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
SESSION_MEMORY_TTL_SECONDS=3600

# ----------------------------------------------------------------- storage
# Di luar Docker, path relatif ini sudah benar. Di dalam Docker, nilainya
# di-override docker-compose.yml ke /data/... yang merupakan volume. Jangan
# menimpanya di sini: kalau path meleset ke filesystem container, seluruh
# dokumen hilang setiap kali container dibuat ulang.
CHROMA_PERSIST_DIR=./data/chroma
SQLITE_FALLBACK_PATH=./data/metadata.db

# ---------------------------------------------------------------- supabase
# Kosongkan untuk memakai SQLite lokal.
#
# Supabase hanya relevan kalau nanti aplikasi diskalakan ke banyak instance,
# karena butuh metadata yang bisa diakses lintas instance. Satu instance dengan
# volume persisten tidak memerlukannya, dan menambahkannya hanya menambah satu
# layanan yang bisa gagal diam-diam.
#
# Catatan jujur: jalur ini belum ditutup test. Jangan andalkan untuk produksi
# tanpa pengujian sendiri lebih dulu.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------- langfuse
# Opsional. Tanpa ini, tracing dilewati dan analytics tidak menampilkan trace.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
TRACING_ENABLED=0
