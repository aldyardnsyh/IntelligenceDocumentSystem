# Konfigurasi backend. Salin jadi .env lalu isi seperlunya.
# .env tidak boleh di-commit.

# ------------------------------------------------------------------ app
# Biarkan false di server yang bisa diakses publik. `true` hanya untuk
# pengembangan lokal: pesan error internal ikut terkirim ke klien.
DEBUG=false

# Origin frontend yang diizinkan, dipisah koma. JANGAN isi `*`.
# Aplikasi ini memakai cookie sesi, dan CORS dengan `*` membuat situs mana pun
# bisa membaca respons API memakai sesi pengguna yang sedang login. Nilainya
# ditolak saat start, bukan hanya diperingatkan.
# Contoh produksi: CORS_ORIGINS=https://domain-anda.example
CORS_ORIGINS=http://localhost:3000

# Tampilkan dokumentasi API interaktif di /docs dan /redoc. Default mati.
# Skema OpenAPI memuat seluruh bentuk request dan response termasuk nama field
# internal, dan /docs membiarkan siapa pun mencoba endpoint tanpa menulis kode.
# Nyalakan (1) hanya kalau aplikasi ini memang demo portofolio publik.
API_DOCS_ENABLED=0

# Percayai `X-Forwarded-For` untuk key rate limit. Nyalakan hanya kalau API
# selalu dijangkau lewat reverse proxy tepercaya (compose+Caddy sudah menyalakan
# ini lewat environment). Tanpa proxy, klien bisa menyusun ulang bucket rate
# limit sesuka hatinya lewat header palsu.
TRUST_PROXY_HEADERS=0

# ---------------------------------------------------------------- security
# WAJIB diisi. Ini SHA-256 dari passcode, bukan passcode-nya.
# Buat dengan:  python -m scripts.make_passcode
# Skrip itu menolak passcode di bawah 12 karakter, karena passcode ini
# melindungi seluruh dokumen pengguna.
ACCESS_PASSCODE_SHA256=
SESSION_TTL_SECONDS=86400
AUTH_MAX_ATTEMPTS=5
AUTH_WINDOW_SECONDS=300

# --------------------------------------------------------------------- llm
# groq   : API cloud, free tier, paling cepat untuk mulai
# ollama : model lokal, data tidak keluar dari mesin
# sglang : self-hosted, untuk trafik RAG dengan prefix bersama
LLM_PROVIDER=mock
# Rantai fallback, dipisah koma. Contoh: groq,ollama
# Kalau Groq kena 429, otomatis pindah ke Ollama.
LLM_FALLBACK_CHAIN=
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=30

# Kosongkan kalau belum mau memakai Groq. Free tier: 1000 request/hari.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Model lokal. qwen2.5:3b jalan di CPU, qwen2.5:7b butuh GPU lebih baik.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# Self-hosted untuk beban lebih besar.
SGLANG_BASE_URL=http://localhost:30000/v1
SGLANG_MODEL=qwen2.5-3b-instruct

# ---------------------------------------------------------------- embedding
# Multilingual, karena dokumen dan pertanyaan berbahasa Indonesia.
# Model Inggris-first seperti all-MiniLM-L6-v2 jauh lebih buruk untuk Bahasa
# Indonesia, dan pengaruhnya ke recall_at_5 turun tajam.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
# Set 0 untuk memakai stub hashing di test.
USE_LOCAL_EMBEDDING=1

# --------------------------------------------------------------- retrieval
# Rentang di sini harus sama persis dengan slider di frontend. Kalau tidak,
# nilai aktif tidak bisa diwakili slider dan pengguna menggeser control yang
# tidak memberi efek.
DEFAULT_TOP_K=5
MIN_TOP_K=3
MAX_TOP_K=10
# 0.5 dipilih karena ambang ini diterapkan pada bukti mentah: cosine
# similarity vektor atau skor BM25 yang sudah diskalakan. Pada embedding
# sungguhan, cosine untuk pertanyaan yang relevan biasanya di atas 0.6, jadi
# 0.5 menyisakan ruang untuk chunk benar yang similarity-nya moderate tanpa
# membiarkan apa pun lolos.
DEFAULT_SIMILARITY_THRESHOLD=0.82
MIN_SIMILARITY_THRESHOLD=0.75
MAX_SIMILARITY_THRESHOLD=0.92
HISTORY_MESSAGE_COUNT=6
CACHE_TTL_SECONDS=1800
QUERY_MAX_PER_SESSION=20
QUERY_WINDOW_SECONDS=60

# --------------------------------------------------------------- documents
MAX_FILE_SIZE_BYTES=10485760

# ------------------------------------------------------------------ redis
# Kosongkan untuk memakai store in-process. Itu pilihan yang benar untuk satu
# instance: Redis menyelesaikan masalah "banyak instance berbagi state", dan
# instance-nya cuma satu.
#
# Konsekuensi yang perlu diketahui: MERESTART LALU DATA SESI HILANG -- judul
# dan jumlah pesan tetap ada di SQLite, tapi isi percakapannya tidak. Untuk
# portofolio ini tidak masalah. Kalau nanti butuh histori bertahan, simpan isi
# pesan ke SQLite (tabelnya sudah ada) daripada menambah Redis.
REDIS_URL=
# Upstash juga dibaca: isi keduanya (atau salah satu) dan store memakai TLS ke
# host Upstash. URL dan token di bagian ini adalah kredensial.
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
SESSION_MEMORY_TTL_SECONDS=3600

# ----------------------------------------------------------------- storage
# Di luar Docker, path relatif ini sudah benar. Di dalam Docker, nilainya
# di-override docker-compose.yml ke /data/... yang merupakan volume. Jangan
# menimpanya di sini: kalau path meleset ke filesystem container, seluruh
# dokumen hilang setiap kali container dibuat ulang.
CHROMA_PERSIST_DIR=./data/chroma
SQLITE_FALLBACK_PATH=./data/metadata.db

# ---------------------------------------------------------------- supabase
# Kosongkan untuk memakai SQLite lokal.
#
# Supabase hanya relevan kalau nanti aplikasi diskalakan ke banyak instance,
# karena butuh metadata yang bisa diakses lintas instance. Satu instance dengan
# volume persisten tidak memerlukannya, dan menambahkannya hanya menambah satu
# layanan yang bisa gagal diam-diam.
#
# Catatan jujur: jalur ini belum ditutup test. Jangan andalkan untuk produksi
# tanpa pengujian sendiri lebih dulu.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------- langfuse
# Opsional. Tanpa ini, tracing dilewati dan analytics tidak menampilkan trace.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
TRACING_ENABLED=0
