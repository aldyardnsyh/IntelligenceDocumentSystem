# Salin berkas ini jadi .env.local, lalu isi seperlunya.
# .env.local tidak boleh di-commit.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------

# Sakelar utama. `1` = UI talking dengan FastAPI sungguhan. Kosong = fixture
# retrieval in-browser, supaya UI tetap bisa dicoba tanpa backend sama sekali.
#
# Pakai `1` untuk pengembangan. Next.js mem-proxy request ke FastAPI lewat
# rewrite di next.config.ts, jadi yang perlu Anda isi di sini hanya URL backend
# itu sendiri, bukan URL yang dipanggil browser.
NEXT_PUBLIC_USE_BACKEND=1

# URL FastAPI, hanya dibaca di server (tidak masuk bundle browser). Harus
# cocok dengan port tempat uvicorn berjalan. Kosongkan kalau tidak memakai
# rewrite; diisi ulang kalau memakai URL absolut, misalnya saat frontend dan
# backend di host berbeda dan keduanya dapat diakses langsung.
BACKEND_ORIGIN=http://localhost:8000

# Override lanjutan: isi hanya kalau browser perlu menembak backend secara
# langsung, bukan lewat proxy. Umumnya TIDAK perlu. Path relatif (kosong) lebih
# aman karena `Set-Cookie` dari endpoint login ikut mengalir di origin yang
# sama; URL absolut membuatnya hilang di server action dan, di dua domain
# terpisah, cookie lintas-domain jadi rapuh.
NEXT_PUBLIC_API_BASE_URL=

# Passcode access gate, BUKAN plaintext yang disimpan di repo.
# Nilai ini dibandingkan dengan hash-nya di server. Kosongkan hanya untuk mode
# pengembangan, yang memakai passcode bawaan yang tampil di layar login.
# Backend aktif: yang menentukan tetap ACCESS_PASSCODE_SHA256 di backend.
DEMO_PASSCODE=

# ---------------------------------------------------------------------------
# Tautan keluar
# ---------------------------------------------------------------------------
# Hanya http:// atau https:// yang diterima. Kosong berarti tombolnya nonaktif
# dengan label "belum diatur", bukan tautan ke halaman yang tidak ada.

NEXT_PUBLIC_REPO_URL=
NEXT_PUBLIC_API_DOCS_URL=
# Base URL instance Langfuse. Kalau diisi, kolom Trace di /analytics jadi tautan
# ke halaman trace-nya.
NEXT_PUBLIC_LANGFUSE_URL=
